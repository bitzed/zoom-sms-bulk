# Copy to .env  ->  cp env.example .env

# ---- Zoom Server-to-Server OAuth (required unless DRY_RUN=true) ----
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# Sender phone number in E.164
SENDER_NUMBER=+818012345678

# ---- Access gate (required) ----
# Shared password for the web UI. The app refuses to start without it.
ACCESS_PASSWORD=change-me

# ---- Storage ----
# Where the SQLite database and boot marker live. Mount a persistent volume here.
DATA_DIR=./data
# Set to "ephemeral" ONLY if you accept that drafts and history vanish on restart.
# STORAGE_MODE=ephemeral

# ---- Rate control ----
# pro -> 10/s nominal, business -> 20/s nominal. Effective ceiling is 80% of nominal.
ZOOM_PLAN=pro
# SEND_RATE_PER_SEC=8      # explicit override of the ceiling
CONCURRENCY=1              # in-flight requests (1-8). Start order always follows input order.

# ---- Retry ----
MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=60000
CIRCUIT_THRESHOLD=10
REQUEST_TIMEOUT_MS=15000
TOKEN_REFRESH_MARGIN_SEC=300

# ---- Safety ----
MAX_RECIPIENTS_PER_JOB=200
QUIET_HOURS=21-8           # JST. Empty string disables.
DRY_RUN=false              # true = never call the Zoom API (UI demo / rehearsal)

# ---- Notifications ----
# Posted a job summary when a job finishes or pauses. Slack-compatible ({"text": ...}).
# This is the only channel that reaches the operator after they close the browser tab.
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
# Absolute base URL, used to build job links inside notifications.
# PUBLIC_URL=https://sms.example.com

# ---- Misc ----
PORT=8080
LOG_LEVEL=info
MASK_PHONE=true
